# HTTP/WebSocket server
WS_PORT=9885

# LLM Provider
# Set to "openai" or "lmstudio"
LLM_PROVIDER=lmstudio
# Base URL for OpenAI-compatible endpoints (LM Studio default: http://127.0.0.1:1234/v1)
LLM_BASE_URL=http://athena.local:1234/v1
# Allow image inputs (set false for text-only models like minimax-m2.5)
LLM_ALLOW_IMAGES=false
# Optional override for provider API key (falls back to OPENAI_API_KEY)
LLM_API_KEY="apikey"

# OpenAI (also used for LM Studio model names/reasoning knobs)
OPENAI_API_KEY="apikey"
OPENAI_MODEL=minimax-m2.5
OPENAI_ALLOW_IMAGES=false
OPENAI_REASONING_EFFORT=high
OPENAI_REASONING_EFFORT_BATTLE=high
OPENAI_REASONING_EFFORT_DIALOG=high
OPENAI_REASONING_EFFORT_CRITICISM=high
OPENAI_REASONING_EFFORT_SUMMARY=xhigh
OPENAI_MODEL_PATHFINDING=minimax-m2.5
OPENAI_REASONING_EFFORT_PATHFINDING=high
OPENAI_REASONING_SUMMARY=auto
OPENAI_TOKEN_LIMIT=128000
OPENAI_TIMEOUT_MS=900000
OPENAI_SERVICE_TIER=priority
OPENAI_SERVICE_TIER_SELF_CRITICISM=priority
OPENAI_SERVICE_TIER_SUMMARY=priority
OPENAI_SERVICE_TIER_PATHFINDING=priority

# Python bridge API (firered_mgba_bridge.py)
PYTHON_BASE_URL=http://127.0.0.1:8000
